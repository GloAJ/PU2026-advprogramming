Iterative

impl Solution {
    pub fn search(nums: Vec<i32>, target: i32) -> i32 {
        let mut left: i32 = 0;
        let mut right: i32 = (nums.len() as i32) - 1;

        while left <= right {
            let mid = left + (right - left) / 2;
            let midv = nums[mid as usize];

            if midv == target {
                return mid;
            } else if midv < target {
                left = mid + 1;
            } else {
                right = mid - 1;
            }


impl Solution {
    pub fn search(nums: Vec<i32>, target: i32) -> i32 {
        match nums.binary_search(&target) {
            Ok(index) => index as i32,
            Err(_) => -1,
        }
    }
}


