Reverse Iteration

impl Solution {
    pub fn plus_one(mut digits: Vec<i32>) -> Vec<i32> {
        for digit in digits.iter_mut().rev() {
            if *digit < 9 {
                *digit += 1;
                return digits;
            }
            *digit = 0;
        }
        digits.insert(0, 1);
        digits
    }
}


While Loop

impl Solution {
    pub fn plus_one(mut digits: Vec<i32>) -> Vec<i32> {
        let mut i = (digits.len() as i32) - 1;
        while i >= 0 {
            if digits[i as usize] == 9 {
                digits[i as usize] = 0;
                i -= 1;
            } else {
                digits[i as usize] += 1;
                return digits;
            }
        }
        digits.insert(0, 1);
        digits
    }
}


Reverse Loop

impl Solution {
    pub fn plus_one(mut digits: Vec<i32>) -> Vec<i32> {
        for i in (0..digits.len()).rev() {
            match digits[i] {
                9 => digits[i] = 0,
                _ => {
                    digits[i] += 1;
                    return digits;
                }
            }
        }
        digits.insert(0, 1);
        digits
    }
}
